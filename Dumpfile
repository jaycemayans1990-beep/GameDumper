-- ============================================================
-- START / CANCEL
-- ============================================================
local statusLabel = TabDump:CreateLabel({ Name = "Status: Idle" })

TabDump:CreateButton({
    Name = "⚡ START DUMP",
    Callback = function()
        if UIState.isRunning then
            addLog("Dump already running — cancel first")
            refreshLog()
            return
        end

        local toDump = {}
        for _, name in ipairs(CONFIG.services) do
            if UIState.selectedServices[name] then
                toDump[#toDump + 1] = name
            end
        end
        if #toDump == 0 then
            addLog("No services selected!")
            refreshLog()
            return
        end

        UIState.isRunning = true
        statusLabel:Set({ Name = "Status: Running..." })
        addLog(("Starting dump — %d services, depth=%d, limit=%d"):format(
            #toDump, CONFIG.depthLimit, CONFIG.instanceLimit))
        refreshLog()

        local lastUpdate = 0
        runDump(toDump, function(count, path)
            local now = os.clock()
            if now - lastUpdate > 0.3 then
                lastUpdate = now
                statusLabel:Set({
                    Name = ("Status: Scanning... %d instances"):format(count)
                })
            end
        end, function(results)
            UIState.isRunning = false
            if results.cancelled then
                statusLabel:Set({ Name = "Status: Cancelled" })
                addLog("Dump cancelled")
                refreshLog()
                return
            end

            statusLabel:Set({ Name = "Status: Saving..." })
            addLog(("Scan done: %d instances, %d scripts in %.1fs"):format(
                results.instances, results.scripts, results.elapsed))
            refreshLog()

            local save = saveDump(results, UIState.gameName, "full")
            addLog(("Saved %d files to: %s"):format(#save.files, save.base))
            addLog(("Summary: %s"):format(save.summary))

            if UIState.saveSpyLog and RemoteSpy.enabled and #RemoteSpy.entries > 0 then
                local spyFile = saveRemoteSpyLog(save.base)
                if spyFile then
                    addLog(("Spy log saved: %s"):format(spyFile))
                end
            end

            statusLabel:Set({
                Name = ("Status: Done — %d inst / %d scripts / %.1fs"):format(
                    results.instances, results.scripts, results.elapsed)
            })
            refreshLog()
        end)
    end,
})

