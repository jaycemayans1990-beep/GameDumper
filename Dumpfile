-- ============================================================
-- RAYFIELD UI LOADER (lightweight — won't freeze on Delta)
-- ============================================================
local function tryLoadRayfield()
    local urls = {
        "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
        "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source",
    }
    for _, url in ipairs(urls) do
        local ok, result = pcall(function()
            return loadstring(game:HttpGet(url))()
        end)
        if ok and result and type(result.CreateWindow) == "function" then
            return result
        end
    end
    return nil
end

local Rayfield = nil

-- ============================================================
-- CONSOLE MODE (fallback — always works on Delta)
-- ============================================================
local function consoleMode()
    print("")
    print("══════════════════════════════════════")
    print("  GAME DUMPER — Console Mode")
    print("  Game: " .. (pc(function() return game.Name end) or "?"))
    print("  Executor: " .. gidentify())
    print("══════════════════════════════════════")
    print("")

    local svcList = {}
    for _, n in ipairs(CONFIG.services) do
        svcList[#svcList + 1] = n
    end

    print("Scanning " .. #svcList .. " services...")
    print("")

    local t0 = os.clock()
    local results = runDump(svcList, function(prog)
        if prog.scanned % 1000 == 0 then
            print(("  [%d inst / %d scripts] %s"):format(prog.scanned, prog.scripts, prog.current))
        end
    end)

    local elapsed = os.clock() - t0

    print("")
    print("Scan complete in " .. ("%.1f"):format(elapsed) .. "s")
    print("  Instances: " .. results.scanned)
    print("  Scripts:   " .. results.scripts)
    print("")

    local gameName = pc(function() return game.Name end) or "UnknownGame"
    local save = saveDump(results, gameName)

    print("Saved to: " .. save.base)
    print("  " .. #save.files .. " files")
    print("  Summary: " .. save.summary)

    if #results.errors > 0 then
        print("")
        print("Errors:")
        for _, e in ipairs(results.errors) do
            print("  " .. e)
        end
    end

    print("")
    print("═══ DONE ═══")
end

-- ============================================================
-- MAIN — try Rayfield, fall back to console
-- ============================================================
local function runUI()
    Rayfield = tryLoadRayfield()
    if not Rayfield then
        print("[GameDumper] Rayfield not available — running console mode")
        consoleMode()
        return
    end

    local Window = Rayfield:CreateWindow({
        Name = "Game Dumper",
        LoadingTitle = "Game Dumper",
        LoadingSubtitle = "Delta Ready",
        ConfigurationSaving = { Enabled = false },
        Discord = { Enabled = false },
        KeySystem = false,
    })

    local TabDump = Window:CreateTab("Dump")
    local TabSpy = Window:CreateTab("Remote Spy")

    local gameName = pc(function() return game.Name end) or "?"
    TabDump:CreateLabel({ Name = "Game: " .. gameName })

    local selectedSvc = {}
    for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end

    TabDump:CreateButton({
        Name = "All On",
        Callback = function()
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end
        end,
    })
    TabDump:CreateButton({
        Name = "All Off",
        Callback = function()
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = false end
        end,
    })
    TabDump:CreateButton({
        Name = "Core Only (WS+RS+Players+SG+SP)",
        Callback = function()
            local core = { Workspace=true, ReplicatedStorage=true, Players=true,
                           StarterGui=true, StarterPack=true, Lighting=true }
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = core[n] or false end
        end,
    })

    for _, n in ipairs(CONFIG.services) do
        TabDump:CreateToggle({
            Name = n,
            CurrentValue = true,
            Callback = function(v) selectedSvc[n] = v end,
        })
    end

    local dumpStatus = TabDump:CreateLabel({ Name = "Ready" })

    TabDump:CreateButton({
        Name = "⚡ START DUMP",
        Callback = function()
            if Dump.running then return end

            local toDump = {}
            for _, n in ipairs(CONFIG.services) do
                if selectedSvc[n] then toDump[#toDump+1] = n end
            end
            if #toDump == 0 then
                dumpStatus:Set({ Name = "No services selected!" })
                return
            end

            dumpStatus:Set({ Name = "Scanning..." })
            Rayfield:Notify({ Title = "Dump", Content = "Starting...", Duration = 2, Image = 4483362458 })

            local co = coroutine.create(function()
                local results = runDump(toDump, function(prog)
                    if prog.scanned % 500 == 0 then
                        coroutine.yield(("Scanning: %d inst / %d scripts"):format(prog.scanned, prog.scripts))
                    end
                end)

                if Dump.cancelled then
                    return "Cancelled"
                end

                local save = saveDump(results, gameName)

                if Spy.enabled and #Spy.entries > 0 then
                    saveSpyLog(save.base)
                end

                return ("Done: %d inst / %d scripts → %s"):format(
                    results.scanned, results.scripts, save.base
                )
            end)

            local function poll()
                local ok, msg = coroutine.resume(co)
                if coroutine.status(co) == "dead" then
                    if ok then
                        dumpStatus:Set({ Name = msg or "Done" })
                        Rayfield:Notify({ Title = "Dump Complete", Content = msg or "Done", Duration = 5, Image = 4483362458 })
                    else
                        dumpStatus:Set({ Name = "Error: " .. tostring(msg) })
                    end
                else
                    if ok and msg then
                        dumpStatus:Set({ Name = msg })
                    end
                    task.wait(0.05)
                    poll()
                end
            end
            poll()
        end,
    })

    TabDump:CreateButton({
        Name = "✕ CANCEL",
        Callback = function()
            Dump.cancelled = true
            dumpStatus:Set({ Name = "Cancelling..." })
        end,
    })

    -- ============================================================
    -- REMOTE SPY TAB
    -- ============================================================
    local spyStatus = TabSpy:CreateLabel({ Name = "Spy: Off" })
    local spyCount = TabSpy:CreateLabel({ Name = "Captured: 0" })

    TabSpy:CreateToggle({
        Name = "Enable Remote Spy",
        CurrentValue = false,
        Callback = function(v)
            if v then
                startSpy()
                spyStatus:Set({ Name = "Spy: ● ACTIVE" })
            else
                stopSpy()
                spyStatus:Set({ Name = "Spy: Off" })
            end
        end,
    })

    TabSpy:CreateButton({
        Name = "Clear Log",
        Callback = function()
            clearSpy()
            spyCount:Set({ Name = "Captured: 0" })
        end,
    })

    TabSpy:CreateButton({
        Name = "Save Spy Log",
        Callback = function()
            local base = CONFIG.saveRoot .. "/spy_" .. os.date("%Y%m%d_%H%M%S")
            local fp = saveSpyLog(base)
            if fp then
                Rayfield:Notify({ Title = "Spy", Content = "Saved: " .. fp, Duration = 3, Image = 4483362458 })
            else
                Rayfield:Notify({ Title = "Spy", Content = "Nothing to save", Duration = 2, Image = 4483362458 })
            end
        end,
    })

    local spyPara = TabSpy:CreateParagraph({
        Name = "Log",
        Text = "Remote spy not started.",
    })

    task.spawn(function()
        while true do
            task.wait(1)
            if Spy.enabled then
                local log = getSpyLog()
                if #log > 0 then
                    local lines = Spy.log
                    local start = math.max(1, #lines - 80)
                    local disp = {}
                    for i = start, #lines do disp[#disp+1] = lines[i] end
                    spyPara:Set({ Name = "Log (" .. #Spy.entries .. ")", Text = table.concat(disp, "\n") })
                else
                    spyPara:Set({ Name = "Log", Text = "No remote calls captured yet." })
                end
                spyCount:Set({ Name = "Captured: " .. #Spy.entries })
            end
        end
    end)

    Rayfield:Notify({
        Title = "Game Dumper",
        Content = "Ready — " .. gameName,
        Duration = 3,
        Image = 4483362458,
    })
end

-- ============================================================
-- GO
-- ============================================================
runUI()
