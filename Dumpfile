local CONFIG = {
    saveRoot = "GameDumps",
    depthLimit = 10,
    instanceLimit = 50000,
    yieldEvery = 8,            -- yield ถี่มากสำหรับมือถือ
    yieldTime = 0.008,
    services = {
        "Workspace", "ReplicatedStorage", "ReplicatedFirst",
        "ServerStorage", "ServerScriptService",
        "StarterGui", "StarterPack", "StarterPlayer",
        "Players", "Lighting",
