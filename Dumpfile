local spyLogParagraph = TabRemote:CreateParagraph({
    Name = "Remote Spy Log",
    Text = "Spy not started yet.",
})

local function refreshSpyDisplay()
    local log = getRemoteSpyLog()
    if #log == 0 then
        spyLogParagraph:Set({ Name = "Remote Spy Log", Text = "No remote calls captured yet." })
    else
        local lines = RemoteSpy.logLines
        local start = math.max(1, #lines - 100)
        local display = {}
        for i = start, #lines do
            display[#display+1] = lines[i]
        end
        spyLogParagraph:Set({
            Name = ("Remote Spy Log (%d entries)"):format(#RemoteSpy.entries),
            Text = table.concat(display, "\n"),
        })
    end
    spyCountLabel:Set({ Name = ("Captured: %d entries"):format(#RemoteSpy.entries) })
end

task.spawn(function()
    while true do
        task.wait(1.5)
        if RemoteSpy.enabled then
            safe(refreshSpyDisplay)
        end
    end
end)

