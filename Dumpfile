-- ============================================================
-- Part 1/3: Config + Globals/Utility + Script Extraction + Dump & Save Engine
-- GameDumper.lua (Delta Executor)
-- ============================================================

-- ============================================================
-- CONFIG
-- ============================================================
CONFIG = {
    saveRoot = "GameDumps",
    depthLimit = 10,
    instanceLimit = 60000,
    yieldEvery = 30,          -- Delta needs frequent yields
    yieldTime = 0.005,        -- tiny wait per batch
    services = {
        "Workspace", "ReplicatedStorage", "ReplicatedFirst",
        "ServerStorage", "ServerScriptService",
        "StarterGui", "StarterPack", "StarterPlayer",
        "Players", "Lighting", "SoundService", "Chat", "Teams",
    },
    -- which ClassNames get source dumped
    scriptClasses = {
        Script = true, LocalScript = true, ModuleScript = true,
    },
    -- max chars per script source (prevent massive files)
    maxSourceChars = 50000,
}

-- ============================================================
-- GLOBALS / FALLBACKS (Delta environment)
-- ============================================================
gwritefile = writefile or function() end
gmakefolder = makefolder or function() end
greadfile = readfile or function() return "" end
gisfile = isfile or function() return false end
gisfolder = isfolder or function() return false end
glistfiles = listfiles or function() return {} end

-- Delta may not have these — nil-safe
gidentify = (getgenv and getgenv().identifyexecutor) or identifyexecutor or function() return "unknown" end

-- ============================================================
-- UTILITY
-- ============================================================
function pc(fn, ...)
    local ok, res = pcall(fn, ...)
    if ok then return res end
    return nil
end

-- clean filename: replace any char unsafe on filesystem
function cleanName(s)
    return (s:gsub("[<>:\"/\\|?*%c]", "_"):gsub("_+", "_"))
end

-- format a value for tree output
function fmtVal(v)
    local t = typeof(v)
    if t == "string" then
        local s = v:gsub("\n", "\\n"):gsub("\r", "")
        if #s > 80 then s = s:sub(1, 80) .. "…" end
        return ('"%s"'):format(s)
    elseif t == "number" then
        if v == math.floor(v) then return tostring(v) end
        return ("%.3f"):format(v)
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "Vector3" then
        return ("(%.1f, %.1f, %.1f)"):format(v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return ("(%.1f, %.1f)"):format(v.X, v.Y)
    elseif t == "CFrame" then
        return ("CF(%.1f,%.1f,%.1f)"):format(v.X, v.Y, v.Z)
    elseif t == "Color3" then
        return ("rgb(%d,%d,%d)"):format(math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255))
    elseif t == "Instance" then
        local cn = pc(function() return v.ClassName end) or "???"
        local nm = pc(function() return v.Name end) or "???"
        return ("->%s.%s"):format(cn, nm)
    elseif t == "EnumItem" then
        return tostring(v)
    else
        return ("<%s>"):format(t)
    end
end

-- ============================================================
-- SCRIPT SOURCE EXTRACTION
-- ============================================================
local function getSource(inst)
    -- method 1: .Source property
    local src = pc(function() return inst.Source end)
    if src and #src > 0 then return src end

    -- method 2: decompile global
    local decomp = decompile or (getgenv and getgenv().decompile)
    if decomp then
        src = pc(decomp, inst)
        if src and #src > 0 then return src end
    end

    return nil
end

-- ============================================================
-- DUMP ENGINE
-- ============================================================
Dump = {
    running = false,
    cancelled = false,
    progress = { scanned = 0, scripts = 0, current = "" },
    treeBuf = {},
    scripts = {},
    errors = {},
}

local TREE = {
    branch = "├── ",
    last = "└── ",
    vert = "│   ",
    space = "    ",
}

local function treePrefix(depths, isLast)
    local parts = {}
    for i = 1, #depths - 1 do
        parts[i] = depths[i] and TREE.space or TREE.vert
    end
    if #depths > 0 then
        parts[#depths] = isLast and TREE.last or TREE.branch
    end
    return table.concat(parts)
end

local function walk(inst, depth, depths, path)
    if Dump.cancelled then return end
    if depth > CONFIG.depthLimit then return end
    if Dump.progress.scanned >= CONFIG.instanceLimit then return end

    Dump.progress.scanned = Dump.progress.scanned + 1

    -- yield frequently for Delta
    if Dump.progress.scanned % CONFIG.yieldEvery == 0 then
        local waitFn = (task and task.wait) or wait or function() end
        waitFn(CONFIG.yieldTime)
    end

    local cn = pc(function() return inst.ClassName end) or "???"
    local nm = pc(function() return inst.Name end) or "???"
    local shortPath = path .. "/" .. nm

    Dump.progress.current = shortPath

    -- tree line
    local prefix = treePrefix(depths, false)
    table.insert(Dump.treeBuf, ("%s%s [%s]"):format(prefix, nm, cn))

    -- script source extraction
    if CONFIG.scriptClasses[cn] then
        local src = getSource(inst)
        if src and #src > 0 then
            if #src > CONFIG.maxSourceChars then
                src = src:sub(1, CONFIG.maxSourceChars) .. "\n--[[ TRUNCATED ]]"
            end
            Dump.progress.scripts = Dump.progress.scripts + 1
            Dump.scripts[#Dump.scripts + 1] = {
                path = shortPath,
                name = nm,
                class = cn,
                source = src,
            }
            table.insert(Dump.treeBuf, prefix .. TREE.space .. "[SOURCE DUMPED]")
        end
    end

    -- children
    local children = pc(function() return inst:GetChildren() end)
    if children and #children > 0 then
        for i, child in ipairs(children) do
            local childDepths = {}
            for _, v in ipairs(depths) do childDepths[#childDepths+1] = v end
            childDepths[#childDepths+1] = (i == #children)
            walk(child, depth + 1, childDepths, shortPath)
        end
    end
end

function runDump(services, onTick)
    Dump.running = true
    Dump.cancelled = false
    Dump.progress = { scanned = 0, scripts = 0, current = "" }
    Dump.treeBuf = {}
    Dump.scripts = {}
    Dump.errors = {}

    for _, svcName in ipairs(services) do
        if Dump.cancelled then break end
        local svc = pc(game.GetService, game, svcName)
        if svc then
            table.insert(Dump.treeBuf, ("[%s]"):format(svcName))
            walk(svc, 0, {}, svcName)
        else
            Dump.errors[#Dump.errors + 1] = ("%s: inaccessible"):format(svcName)
            table.insert(Dump.treeBuf, ("[%s] INACCESSIBLE"):format(svcName))
        end
        if onTick then onTick(Dump.progress) end
    end

    Dump.running = false
    return {
        scanned = Dump.progress.scanned,
        scripts = Dump.progress.scripts,
        tree = table.concat(Dump.treeBuf, "\n"),
        errors = Dump.errors,
        scriptList = Dump.scripts,
    }
end

-- ============================================================
-- SAVE ENGINE
-- ============================================================
function saveDump(results, gameName)
    local ts = os.date("%Y%m%d_%H%M%S")
    local base = CONFIG.saveRoot .. "/" .. cleanName(gameName) .. "_" .. ts
    pc(gmakefolder, CONFIG.saveRoot)
    pc(gmakefolder, base)

    local saved = {}

    -- 1. tree
    local treePath = base .. "/_tree.txt"
    local treeHeader = ("-- Game: %s\n-- Date: %s\n-- Instances: %d\n-- Scripts: %d\n\n"):format(
        gameName, os.date("%Y-%m-%d %H:%M:%S"), results.scanned, results.scripts
    )
    pc(gwritefile, treePath, treeHeader .. results.tree)
    saved[#saved + 1] = treePath

    -- 2. script index
    local idxPath = base .. "/_scripts_index.txt"
    local idxLines = {}
    for _, s in ipairs(results.scriptList) do
        idxLines[#idxLines + 1] = ("%s :: %s [%s] (%d chars)"):format(
            s.path, s.name, s.class, #s.source
        )
    end
    pc(gwritefile, idxPath, table.concat(idxLines, "\n"))
    saved[#saved + 1] = idxPath

    -- 3. individual script files
    if #results.scriptList > 0 then
        local scrDir = base .. "/scripts"
        pc(gmakefolder, scrDir)

        -- group by top-level service
        local bySvc = {}
        for _, s in ipairs(results.scriptList) do
            local svc = s.path:match("^([^/]+)") or "root"
            if not bySvc[svc] then bySvc[svc] = {} end
            bySvc[svc][#bySvc[svc] + 1] = s
        end

        for svc, list in pairs(bySvc) do
            local svcDir = scrDir .. "/" .. cleanName(svc)
            pc(gmakefolder, svcDir)

            for i, s in ipairs(list) do
                local fn = cleanName(s.name) .. "_" .. i .. ".lua"
                local fp = svcDir .. "/" .. fn
                local header = ("--[[ Path: %s | Class: %s | Name: %s ]]\n\n"):format(
                    s.path, s.class, s.name
                )
                pc(gwritefile, fp, header .. s.source)
                saved[#saved + 1] = fp
            end
        end
    end

    -- 4. summary
    local sumPath = base .. "/_summary.txt"
    local sum = ("GameDumper Summary\n==================\nGame: %s\nPlaceId: %s\nDate: %s\nInstances: %d\nScripts: %d\nErrors: %d\nFiles: %d\n\nFiles:\n%s"):format(
        gameName,
        pc(function() return game.PlaceId end) or "?",
        os.date("%Y-%m-%d %H:%M:%S"),
        results.scanned,
        results.scripts,
        #results.errors,
        #saved,
        table.concat(saved, "\n")
    )
    pc(gwritefile, sumPath, sum)
    saved[#saved + 1] = sumPath

    return { base = base, files = saved, summary = sumPath }
end
-- ============================================================
-- Part 2/3: Remote Spy Engine (Hooks + Scanner + Log Saver)
-- GameDumper.lua (ต้องมี Part 1/3 รันก่อน)
-- ============================================================

Spy = {
    enabled = false,
    log = {},
    entries = {},
    maxEntries = 3000,
    hooked = {},
    nameCache = {},
}

local function remotePath(r)
    local cached = Spy.nameCache[r]
    if cached then return cached end
    local p = pc(function() return r.Name end) or "?"
    local parent = pc(function() return r.Parent end)
    local hops = 0
    while parent and parent ~= game and hops < 12 do
        p = (pc(function() return parent.Name end) or "?") .. "." .. p
        parent = pc(function() return parent.Parent end)
        hops = hops + 1
    end
    Spy.nameCache[r] = p
    return p
end

local function spyLog(kind, remote, args, rets)
    if not Spy.enabled then return end
    local path = remotePath(remote)
    local line = ("[%s] %s %s"):format(os.date("%H:%M:%S"), kind, path)

    if args and #args > 0 then
        for i, a in ipairs(args) do
            line = line .. ("\n  arg[%d] = %s"):format(i, fmtVal(a))
        end
    end
    if rets and #rets > 0 then
        for i, r in ipairs(rets) do
            line = line .. ("\n  ret[%d] = %s"):format(i, fmtVal(r))
        end
    end

    Spy.log[#Spy.log + 1] = line
    Spy.entries[#Spy.entries + 1] = {
        time = os.clock(), stamp = os.date("%H:%M:%S"),
        kind = kind, path = path, args = args, returns = rets,
    }
    if #Spy.log > Spy.maxEntries then
        table.remove(Spy.log, 1)
        table.remove(Spy.entries, 1)
    end
end

local function hookOne(remote)
    if Spy.hooked[remote] then return end
    Spy.hooked[remote] = true

    local cn = pc(function() return remote.ClassName end)

    if cn == "RemoteEvent" then
        if remote.FireServer then
            local orig = remote.FireServer
            remote.FireServer = function(...)
                local a = {...}
                spyLog("FireServer", remote, a, nil)
                return pc(orig, remote, unpack(a))
            end
        end
        if remote.FireClient then
            local orig = remote.FireClient
            remote.FireClient = function(...)
                local a = {...}
                spyLog("FireClient", remote, a, nil)
                return pc(orig, remote, unpack(a))
            end
        end
        if remote.OnClientEvent and remote.OnClientEvent.Connect then
            local orig = remote.OnClientEvent.Connect
            remote.OnClientEvent.Connect = function(self, cb)
                return orig(self, function(...)
                    local a = {...}
                    spyLog("OnClientEvent", remote, a, nil)
                    return cb(...)
                end)
            end
        end
    elseif cn == "RemoteFunction" then
        if remote.InvokeServer then
            local orig = remote.InvokeServer
            remote.InvokeServer = function(...)
                local a = {...}
                local rets = {pc(orig, remote, unpack(a))}
                spyLog("InvokeServer", remote, a, rets)
                return unpack(rets)
            end
        end
        if remote.InvokeClient then
            local orig = remote.InvokeClient
            remote.InvokeClient = function(...)
                local a = {...}
                local rets = {pc(orig, remote, unpack(a))}
                spyLog("InvokeClient", remote, a, rets)
                return unpack(rets)
            end
        end
        if remote.OnClientInvoke and remote.OnClientInvoke.Connect then
            local orig = remote.OnClientInvoke.Connect
            remote.OnClientInvoke.Connect = function(self, cb)
                return orig(self, function(...)
                    local a = {...}
                    local rets = {cb(...)}
                    spyLog("OnClientInvoke", remote, a, rets)
                    return unpack(rets)
                end)
            end
        end
    end
end

local function scanRemotes(root, depth)
    if depth > 6 then return end
    local children = pc(function() return root:GetChildren() end)
    if not children then return end
    for _, child in ipairs(children) do
        local cn = pc(function() return child.ClassName end)
        if cn == "RemoteEvent" or cn == "RemoteFunction" then
            hookOne(child)
        end
        scanRemotes(child, depth + 1)
    end
end

function startSpy()
    Spy.enabled = true
    local roots = {
        pc(game.GetService, game, "ReplicatedStorage"),
        pc(game.GetService, game, "ReplicatedFirst"),
        pc(game.GetService, game, "Players"),
        pc(game.GetService, game, "Workspace"),
        pc(game.GetService, game, "StarterGui"),
        pc(game.GetService, game, "StarterPack"),
    }
    for _, r in ipairs(roots) do
        if r then scanRemotes(r, 0) end
    end

    -- DescendantAdded watcher for late-spawning remotes
    local function watch(svc)
        local da = pc(function() return svc.DescendantAdded end)
        if da and da.Connect then
            da:Connect(function(d)
                local cn = pc(function() return d.ClassName end)
                if cn == "RemoteEvent" or cn == "RemoteFunction" then
                    hookOne(d)
                end
            end)
        end
    end
    for _, r in ipairs(roots) do
        if r then watch(r) end
    end
end

function stopSpy()
    Spy.enabled = false
end

function clearSpy()
    Spy.log = {}
    Spy.entries = {}
end

function getSpyLog()
    return table.concat(Spy.log, "\n")
end

function saveSpyLog(basePath)
    local log = getSpyLog()
    if #log == 0 then return nil end
    pc(gmakefolder, basePath)
    local fp = basePath .. "/remote_spy.txt"
    local hdr = ("-- Remote Spy Log\n-- Game: %s\n-- Entries: %d\n-- %s\n\n"):format(
        pc(function() return game.Name end) or "?", #Spy.entries, os.date("%Y-%m-%d %H:%M:%S")
    )
    pc(gwritefile, fp, hdr .. log)
    return fp
end
