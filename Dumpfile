-- MAIN UI WITH ORION
-- ============================================================
local function runUI()
    local Orion = tryLoadOrion()

    if not Orion then
        -- Fallback: console mode
        print("══════════════════════════════════════")
        print("  GAME DUMPER — Console Mode")
        print("  เกม: " .. (pc(function() return game.Name end) or "?"))
        print("══════════════════════════════════════")
        print("")
        print("❌ Orion UI โหลดไม่สำเร็จ")
        print("🔹 พิมพ์ _G.StartDump() เพื่อเริ่มสแกน")
        print("   หรือ _G.StartDump({'Workspace','Players'}) เลือก Service เอง")
        print("")
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Game Dumper",
                Text = "พิมพ์ _G.StartDump() ในคอนโซลเพื่อเริ่ม",
                Duration = 10,
            })
        end)

        _G.StartDump = function(services)
            local svc = services or CONFIG.services
            local gameName = pc(function() return game.Name end) or "UnknownGame"
            local results = Dump.run(svc, function(prog)
                if prog.scanned % 500 == 0 then
                    print(("  [%d inst / %d scripts] %s"):format(prog.scanned, prog.scripts, prog.current))
                end
            end)
            local save = saveDump(results, gameName)
            print("✅ เสร็จ! " .. save.base .. " (" .. #save.files .. " files)")
            print("📊 Instances: " .. results.scanned .. " | Scripts: " .. results.scripts)
        end
        return
    end

    -- ============================================================
    -- ORION UI BUILD
    -- ============================================================
    local Window = Orion:MakeWindow({
        Name = "Game Dumper",
        HidePremium = false,
        SaveConfig = false,
        ConfigFolder = "GameDumper",
        IntroEnabled = true,
        IntroText = "Game Dumper",
    })

    local TabDump = Window:MakeTab({
        Name = "Dump",
        Icon = "rbxassetid://4483345998",
        PremiumOnly = false,
    })

    local TabSpy = Window:MakeTab({
        Name = "Remote Spy",
        Icon = "rbxassetid://7733956259",
        PremiumOnly = false,
    })

    -- Selected services (default: all on)
    local selectedSvc = {}
    for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end

    local gameName = pc(function() return game.Name end) or "?"

    TabDump:AddLabel("🎮 Game: " .. gameName)
    TabDump:AddLabel("───────────────")

    -- Quick buttons
    TabDump:AddButton({
        Name = "All ON",
        Callback = function()
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end
        end,
    })

    TabDump:AddButton({
        Name = "All OFF",
        Callback = function()
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = false end
        end,
    })

    TabDump:AddButton({
        Name = "Core Only (WS+RS+PL+SG+SP)",
        Callback = function()
            local core = { Workspace=true, ReplicatedStorage=true, Players=true,
                           StarterGui=true, StarterPack=true, Lighting=true }
            for _, n in ipairs(CONFIG.services) do selectedSvc[n] = core[n] or false end
        end,
    })

    TabDump:AddLabel("───────────────")
    TabDump:AddLabel("Service Toggles:")

    -- Toggles for each service
    for _, n in ipairs(CONFIG.services) do
        TabDump:AddToggle({
            Name = n,
            Default = true,
            Callback = function(v) selectedSvc[n] = v end,
        })
    end

    TabDump:AddLabel("───────────────")

    -- Status label
    local dumpStatusLabel = TabDump:AddLabel("⏳ Ready")

    -- START DUMP button
    TabDump:AddButton({
        Name = "⚡ START DUMP",
        Callback = function()
            if Dump.running then
                Orion:MakeNotification({
                    Name = "Game Dumper",
                    Content = "Already scanning!",
                    Time = 3,
                })
                return
            end

            local toDump = {}
            for _, n in ipairs(CONFIG.services) do
                if selectedSvc[n] then toDump[#toDump+1] = n end
            end

            if #toDump == 0 then
                Orion:MakeNotification({
                    Name = "Game Dumper",
                    Content = "Please select at least 1 service!",
                    Time = 3,
                })
                return
            end

            dumpStatusLabel:Set("🔍 Scanning... (0 inst)")

            -- Run dump in coroutine
            local co = coroutine.create(function()
                local results = Dump.run(toDump, function(prog)
                    if prog.scanned % 200 == 0 then
                        coroutine.yield(("🔍 Scanning... (%d inst / %d scripts)"):format(
                            prog.scanned, prog.scripts
                        ))
                    end
                end)

                if Dump.cancelled then
                    return "❌ Cancelled"
                end

                local save = saveDump(results, gameName)
                if Spy.enabled and #Spy.entries > 0 then
                    saveSpyLog(save.base)
                end

                Orion:MakeNotification({
                    Name = "Dump Complete ✅",
                    Content = ("%d inst / %d scripts\nSaved: %s"):format(
                        results.scanned, results.scripts, save.base
                    ),
                    Time = 8,
                })
                return ("✅ Done: %d inst / %d scripts"):format(results.scanned, results.scripts)
            end)

            -- Poll coroutine without freezing UI
            local function poll()
                local ok, msg = coroutine.resume(co)
                if coroutine.status(co) == "dead" then
                    dumpStatusLabel:Set(msg or "✅ Done")
                else
                    if ok and msg then
                        dumpStatusLabel:Set(msg)
                    end
                    safeYield(0.05)
                    poll()
                end
            end
            poll()
        end,
    })

    -- CANCEL button
    TabDump:AddButton({
        Name = "✕ CANCEL",
        Callback = function()
            Dump.cancelled = true
            dumpStatusLabel:Set("⏹ Cancelling...")
        end,
    })
    -- ============================================================
    -- REMOTE SPY TAB
    -- ============================================================
    local spyStatusLabel = TabSpy:AddLabel("📡 Spy: OFF")
    local spyCountLabel = TabSpy:AddLabel("📊 Captured: 0")

    TabSpy:AddToggle({
        Name = "Enable Remote Spy",
        Default = false,
        Callback = function(v)
            if v then
                startSpy()
                spyStatusLabel:Set("📡 Spy: ● ACTIVE")
            else
                stopSpy()
                spyStatusLabel:Set("📡 Spy: OFF")
            end
        end,
    })

    TabSpy:AddButton({
        Name = "Clear Log",
        Callback = function()
            clearSpy()
            spyCountLabel:Set("📊 Captured: 0")
        end,
    })

    TabSpy:AddButton({
        Name = "Save Spy Log",
        Callback = function()
            local base = CONFIG.saveRoot .. "/spy_" .. os.date("%Y%m%d_%H%M%S")
            local fp = saveSpyLog(base)
            if fp then
                Orion:MakeNotification({
                    Name = "Spy Saved",
                    Content = fp,
                    Time = 5,
                })
            else
                Orion:MakeNotification({
                    Name = "Spy",
                    Content = "Nothing to save",
                    Time = 3,
                })
            end
        end,
    })

    local spyLogBox = TabSpy:AddTextbox({
        Name = "Live Log",
        Default = "Remote spy log will appear here...",
        TextDisappear = false,
        Callback = function() end,
    })
    -- Auto-refresh spy log
    coroutine.wrap(function()
        while true do
            safeYield(1)
            if Spy.enabled then
                local log = getSpyLog()
                if #log > 0 then
                    local lines = Spy.log
                    local start = math.max(1, #lines - 50)
                    local disp = {}
                    for i = start, #lines do disp[#disp+1] = lines[i] end
                    spyLogBox:Set(table.concat(disp, "\n"))
                else
                    spyLogBox:Set("No remote calls captured yet.")
                end
                spyCountLabel:Set("📊 Captured: " .. #Spy.entries)
            end
        end
    end)()

    -- ============================================================
    -- INIT COMPLETE
    -- ============================================================
    Orion:Init()
    Orion:MakeNotification({
        Name = "Game Dumper",
        Content = "Ready — " .. gameName,
        Time = 3,
    })
end

-- ============================================================
-- GO
-- ============================================================
runUI()
