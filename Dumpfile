-- MAIN
-- ============================================================
local function runUI()
    local Rayfield = tryLoadRayfield()

    if not Rayfield then
        -- ไม่มี Rayfield -> ใช้คอนโซล + ต้องพิมพ์ _G.StartDump() เพื่อเริ่ม
        print("══════════════════════════════════════")
        print("  GAME DUMPER — Console Mode")
        print("  เกม: " .. (pc(function() return game.Name end) or "?"))
        print("══════════════════════════════════════")
        print("")
        print("❌ Rayfield UI ไม่พร้อมใช้งาน (หรือโหลดไม่ทัน)")
        print("")
        print("🔹 พิมพ์ _G.StartDump() ในคอนโซลเพื่อเริ่มสแกน")
        print("   หรือ _G.StartDump({'Workspace','Players'}) เพื่อเลือก Service เอง")
        print("")
        showNotification("Game Dumper", "พิมพ์ _G.StartDump() ในคอนโซลเพื่อเริ่ม", 10)

        -- ฟังก์ชันให้ผู้ใช้เรียก
        _G.StartDump = function(services)
            local svc = services or CONFIG.services
            startDumpInteractive(svc)
        end
        return
    end

    -- สร้าง UI ด้วย Rayfield
    local Window = Rayfield:CreateWindow({
        Name = "Game Dumper",
        LoadingTitle = "Game Dumper",
        LoadingSubtitle = "Delta Ready",
        ConfigurationSaving = { Enabled = false },
        Discord = { Enabled = false },
        KeySystem = false,
    })

    local TabDump = Window:CreateTab("Dump")
    local gameName = pc(function() return game.Name end) or "?"
    TabDump:CreateLabel({ Name = "Game: " .. gameName })

    local selectedSvc = {}
    for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end

    TabDump:CreateButton({ Name = "All On", Callback = function()
        for _, n in ipairs(CONFIG.services) do selectedSvc[n] = true end
    end })
    TabDump:CreateButton({ Name = "All Off", Callback = function()
        for _, n in ipairs(CONFIG.services) do selectedSvc[n] = false end
    end })
    TabDump:CreateButton({ Name = "Core Only", Callback = function()
        local core = { Workspace=true, ReplicatedStorage=true, Players=true, StarterGui=true, StarterPack=true, Lighting=true }
        for _, n in ipairs(CONFIG.services) do selectedSvc[n] = core[n] or false end
    end })

    for _, n in ipairs(CONFIG.services) do
        TabDump:CreateToggle({
            Name = n,
            CurrentValue = true,
            Callback = function(v) selectedSvc[n] = v end,
        })
    end

    local dumpStatus = TabDump:CreateLabel({ Name = "Ready" })

    TabDump:CreateButton({
        Name = "⚡ START DUMP",
        Callback = function()
            if Dump.running then return end
            local toDump = {}
            for _, n in ipairs(CONFIG.services) do
                if selectedSvc[n] then toDump[#toDump+1] = n end
            end
            if #toDump == 0 then
                dumpStatus:Set({ Name = "No services selected!" })
                return
            end
            dumpStatus:Set({ Name = "Scanning..." })
            Rayfield:Notify({ Title = "Dump", Content = "Starting...", Duration = 2, Image = 4483362458 })

            -- ใช้ coroutine เพื่อไม่ให้ UI ค้าง
            local co = coroutine.create(function()
                local results = Dump.run(toDump, function(prog)
                    if prog.scanned % 500 == 0 then
                        coroutine.yield(("Scanning: %d inst / %d scripts"):format(prog.scanned, prog.scripts))
                    end
                end)
                if Dump.cancelled then return "Cancelled" end
                local save = saveDump(results, gameName)
                return ("Done: %d inst / %d scripts → %s"):format(results.scanned, results.scripts, save.base)
            end)

            local function poll()
                local ok, msg = coroutine.resume(co)
                if coroutine.status(co) == "dead" then
                    if ok then
                        dumpStatus:Set({ Name = msg or "Done" })
                        Rayfield:Notify({ Title = "Dump Complete", Content = msg or "Done", Duration = 5, Image = 4483362458 })
                    else
                        dumpStatus:Set({ Name = "Error: " .. tostring(msg) })
                    end
                else
                    if ok and msg then dumpStatus:Set({ Name = msg }) end
                    safeYield(0.05)
                    poll()
                end
            end
            poll()
        end,
    })

    TabDump:CreateButton({
        Name = "✕ CANCEL",
        Callback = function()
            Dump.cancelled = true
            dumpStatus:Set({ Name = "Cancelling..." })
        end,
    })

    -- Remote Spy Tab (เหมือนเดิม) ...
    -- (ใส่โค้ดเดิมของ Spy ตรงนี้)

    Rayfield:Notify({ Title = "Game Dumper", Content = "Ready — " .. gameName, Duration = 3, Image = 4483362458 })
end

runUI()
