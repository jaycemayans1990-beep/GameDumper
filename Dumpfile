        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = text
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 14
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = true
        btn.Parent = main
        return btn
    end

    local yPos = 95
    local dumpAllBtn = createButton("⚡ DUMP ALL", yPos, Color3.fromRGB(40, 160, 40))
    yPos = yPos + 55

    local scriptsBtn = createButton("📜 SCRIPTS ONLY", yPos, Color3.fromRGB(160, 100, 40))
    yPos = yPos + 55

    local spyBtn = createButton("📡 SPY: OFF", yPos, Color3.fromRGB(60, 60, 220))
    yPos = yPos + 55

    local cancelBtn = createButton("✕ CANCEL", yPos, Color3.fromRGB(180, 40, 40))
    yPos = yPos + 55

    -- Log area
