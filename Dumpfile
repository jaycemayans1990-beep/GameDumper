    -- ============================================================
    -- BUTTON LOGIC
    -- ============================================================
    dumpAllBtn.MouseButton1Click:Connect(function()
        if Dumper.running then return end
        status.Text = "🔍 Scanning all services..."
        coroutine.wrap(function()
            local svcs = {}
            for _, s in ipairs(CONFIG.services) do svcs[#svcs+1] = s end
            local results = Dumper.scan(svcs)
            local save = Dumper.save(results, pcall(function() return game.Name end) and game.Name or "Game")
            status.Text = string.format("✅ %d inst, %d scripts", results.scanned, results.scripts)
        end)()
    end)

    scriptsBtn.MouseButton1Click:Connect(function()
        if Dumper.running then return end
        status.Text = "🔍 Scanning scripts only..."
        coroutine.wrap(function()
            local oldDepth = CONFIG.depthLimit
            CONFIG.depthLimit = 6
            local svcs = {}
            for _, s in ipairs(CONFIG.services) do svcs[#svcs+1] = s end
            local results = Dumper.scan(svcs)
            CONFIG.depthLimit = oldDepth
            local save = Dumper.save(results, pcall(function() return game.Name end) and game.Name .. "_scripts" or "Game_scripts")
            status.Text = string.format("✅ %d scripts", results.scripts)
        end)()
    end)

    spyBtn.MouseButton1Click:Connect(function()
        if Spy.active then
            Spy.stop()
            spyBtn.Text = "📡 SPY: OFF"
            spyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 220)
            status.Text = "Spy disabled"
        else
            Spy.start()
            spyBtn.Text = "📡 SPY: ON"
            spyBtn.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
            status.Text = "Spy active"
        end
    end)

    cancelBtn.MouseButton1Click:Connect(function()
        Dumper.cancelled = true
        status.Text = "⏹ Cancelled"
    end)

    -- ============================================================
    -- DRAG FUNCTIONALITY (Touch + Mouse)
    -- ============================================================
    local dragging, dragStart, startPos
    local function startDrag(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end
    local function endDrag()
        dragging = false
    end
    local function updateDrag(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end

    titleBar.InputBegan:Connect(startDrag)
    titleBar.InputEnded:Connect(endDrag)
    titleBar.InputChanged:Connect(updateDrag)

    -- ============================================================
    -- LOG UPDATER (จะหยุดถ้า gui ถูกทำลาย)
    -- ============================================================
    coroutine.wrap(function()
        while gui and gui.Parent do
