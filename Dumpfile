local function loadRayfield()
    local urls = {
        "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
        "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source",
        "https://raw.githubusercontent.com/UI-Libraries/Rayfield/main/source",
    }

    for _, url in ipairs(urls) do
        local ok, result = pcall(function()
            return loadstring(game:HttpGet(url))()
        end)
        if ok and result and type(result.CreateWindow) == "function" then
            return result
        end
    end
    return nil
end

local Rayfield = loadRayfield()

if not Rayfield then
    warn("[GameDumper] Rayfield not available — running console mode")
    warn("[GameDumper] Dumping all services with default settings...")

    local svcList = {}
    for _, name in ipairs(CONFIG.services) do
        svcList[#svcList + 1] = name
    end

    runDump(svcList, function(count, path)
        if count % 2000 == 0 then
            print(("[GameDumper] %d instances scanned — %s"):format(count, path))
        end
    end, function(results)
        local save = saveDump(results, game.Name or "dump", "full")
        print(("[GameDumper] Done! %d instances, %d scripts in %.2fs"):format(
            results.instances, results.scripts, results.elapsed))
        print(("[GameDumper] Saved to: %s"):format(save.base))
        print(("[GameDumper] Summary: %s"):format(save.summary))
    end)
    return
end

