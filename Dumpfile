    },
    maxSourceChars = 40000,
}

-- safe functions
local function safeWrite(...) pcall(writefile or function() end, ...) end
local function safeMkdir(...) pcall(makefolder or function() end, ...) end
local function safePcall(fn, ...)
    local ok, res = pcall(fn, ...)
    return ok and res or nil
end
local function cleanName(s)
    return (tostring(s):gsub("[<>:\"/\\|?*%c]", "_"):gsub("_+", "_"))
end

-- YIELD - ใช้ 3 วิธีเผื่อ Delta ไม่มีบางอัน
local function doYield(t)
    if task and task.wait then
        task.wait(t)
    elseif wait then
        wait(t)
    else
        local rs = game:GetService("RunService")
        local st = os.clock()
        repeat rs.Heartbeat:Wait() until os.clock() - st >= t
    end
end

-- Get source
local function getSource(inst)
    local src = safePcall(function() return inst.Source end)
    if src and #src > 0 then return src end
    
    local decomp = nil
    pcall(function() decomp = decompile or getgenv().decompile end)
    if decomp then
        src = safePcall(decomp, inst)
        if src and #src > 0 then return src end
    end
    return nil
end

-- ============================================================
-- DUMP ENGINE
-- ============================================================
local Dumper = {
    running = false,
    cancelled = false,
    stats = { scanned = 0, scripts = 0, current = "" },
    treeLines = {},
    scriptData = {},
    errors = {},
}

local function walkInstance(inst, depth, svcPath)
    if Dumper.cancelled then return end
    if depth > CONFIG.depthLimit then return end
    if Dumper.stats.scanned >= CONFIG.instanceLimit then return end

    Dumper.stats.scanned = Dumper.stats.scanned + 1

    -- yield
    if Dumper.stats.scanned % CONFIG.yieldEvery == 0 then
        doYield(CONFIG.yieldTime)
    end

    local cn = safePcall(function() return inst.ClassName end) or "???"
    local nm = safePcall(function() return inst.Name end) or "???"
    local fullPath = svcPath .. "/" .. nm
    Dumper.stats.current = fullPath:sub(-80) -- keep short for display

    -- tree
    local indent = string.rep("  ", depth)
    Dumper.treeLines[#Dumper.treeLines + 1] = indent .. nm .. " [" .. cn .. "]"

    -- scripts
    if CONFIG.scriptClasses[cn] then
        local src = getSource(inst)
        if src and #src > 0 then
            if #src > CONFIG.maxSourceChars then
                src = src:sub(1, CONFIG.maxSourceChars) .. "\n--[[TRUNCATED]]"
            end
            Dumper.stats.scripts = Dumper.stats.scripts + 1
            Dumper.scriptData[#Dumper.scriptData + 1] = {
                path = fullPath, name = nm, class = cn, source = src,
            }
        end
    end

    -- children
    local children = safePcall(function() return inst:GetChildren() end)
    if children then
        for _, child in ipairs(children) do
            walkInstance(child, depth + 1, fullPath)
        end
    end
end

function Dumper.scan(serviceList)
    Dumper.running = true
    Dumper.cancelled = false
    Dumper.stats = { scanned = 0, scripts = 0, current = "" }
    Dumper.treeLines = {}
    Dumper.scriptData = {}
    Dumper.errors = {}

    local totalSvcs = #serviceList

    for idx, svcName in ipairs(serviceList) do
        if Dumper.cancelled then break end
        
        Dumper.stats.current = svcName .. " (" .. idx .. "/" .. totalSvcs .. ")"
        
        local svc = safePcall(game.GetService, game, svcName)
        if svc then
            Dumper.treeLines[#Dumper.treeLines + 1] = "[" .. svcName .. "]"
            walkInstance(svc, 1, svcName)
        else
            Dumper.errors[#Dumper.errors + 1] = svcName .. ": failed"
            Dumper.treeLines[#Dumper.treeLines + 1] = "[" .. svcName .. "] FAILED"
        end
        
        doYield(0.01)
    end

    Dumper.running = false
    return {
        scanned = Dumper.stats.scanned,
        scripts = Dumper.stats.scripts,
        tree = table.concat(Dumper.treeLines, "\n"),
        errors = Dumper.errors,
        scriptList = Dumper.scriptData,
    }
end

-- ============================================================
-- SAVE
-- ============================================================
function Dumper.save(results, gameName)
    local ts = os.date("%Y%m%d_%H%M%S")
    local base = CONFIG.saveRoot .. "/" .. cleanName(gameName) .. "_" .. ts
    safeMkdir(CONFIG.saveRoot)
    safeMkdir(base)

    local files = {}

    -- tree
    local tp = base .. "/tree.txt"
    safeWrite(tp, ("Game: %s | %s | %d inst | %d scripts\n\n"):format(
        gameName, os.date(), results.scanned, results.scripts) .. results.tree)
    files[#files+1] = tp

    -- scripts
    if #results.scriptList > 0 then
        local sd = base .. "/scripts"
        safeMkdir(sd)
        for i, s in ipairs(results.scriptList) do
            local fn = string.format("%04d_%s.lua", i, cleanName(s.name):sub(1, 40))
            local fp = sd .. "/" .. fn
            safeWrite(fp, ("--[[ %s | %s ]]\n\n"):format(s.path, s.class) .. s.source)
            files[#files+1] = fp
        end
    end

    -- summary
    local sp = base .. "/summary.txt"
    safeWrite(sp, ("Done!\nGame: %s\nInstances: %d\nScripts: %d\nFiles: %d\n\n%s"):format(
        gameName, results.scanned, results.scripts, #files, table.concat(files, "\n")))
    files[#files+1] = sp

    return { base = base, count = #files }
end

-- ============================================================
-- REMOTE SPY
-- ============================================================
local Spy = {
    active = false,
    log = {},
    entries = 0,
    hooked = {},
}
local SpyLog = {}

function Spy.hook(remote)
    if Spy.hooked[remote] then return end
    Spy.hooked[remote] = true
    
    local cn = safePcall(function() return remote.ClassName end)
    local path = safePcall(function() return remote:GetFullName() end) or "?"
    
    if cn == "RemoteEvent" then
        pcall(function()
            local old = remote.FireServer
            remote.FireServer = function(...)
                Spy.entries = Spy.entries + 1
                if #SpyLog > 1000 then table.remove(SpyLog, 1) end
                SpyLog[#SpyLog+1] = ("[%s] %s"):format(os.date("%H:%M:%S"), path)
                return old(remote, ...)
            end
        end)
    elseif cn == "RemoteFunction" then
        pcall(function()
            local old = remote.InvokeServer
            remote.InvokeServer = function(...)
                Spy.entries = Spy.entries + 1
                if #SpyLog > 1000 then table.remove(SpyLog, 1) end
                SpyLog[#SpyLog+1] = ("[%s] %s"):format(os.date("%H:%M:%S"), path)
                return old(remote, ...)
            end
        end)
    end
end

function Spy.scan(root, depth)
    if depth > 5 then return end
    local ch = safePcall(function() return root:GetChildren() end)
    if not ch then return end
    for _, c in ipairs(ch) do
        local cn = safePcall(function() return c.ClassName end)
        if cn == "RemoteEvent" or cn == "RemoteFunction" then
            Spy.hook(c)
        end
        Spy.scan(c, depth + 1)
    end
end

function Spy.start()
    Spy.active = true
    Spy.scan(game:GetService("ReplicatedStorage"), 0)
    Spy.scan(game:GetService("Players"), 0)
    Spy.scan(game:GetService("Workspace"), 0)
end

function Spy.stop()
    Spy.active = false
end

function Spy.clear()
    SpyLog = {}
    Spy.entries = 0
end

function Spy.getLog()
    if #SpyLog == 0 then return "No calls yet" end
    local lines = {}
    local start = math.max(1, #SpyLog - 40)
    for i = start, #SpyLog do lines[#lines+1] = SpyLog[i] end
    return table.concat(lines, "\n")
end

