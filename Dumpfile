-- ============================================================
-- โหลด Rayfield แบบมี Timeout (ไม่เกิน 3 วิ)
-- ============================================================
local function tryLoadRayfield()
    local urls = {
        "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
        "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source",
    }
    for _, url in ipairs(urls) do
        local success, result
        local co = coroutine.create(function()
            success, result = pcall(function()
                return loadstring(game:HttpGet(url))()
            end)
        end)
        coroutine.resume(co)
        local t = os.clock()
        while coroutine.status(co) ~= "dead" and os.clock() - t < 3 do
            safeYield(0.05)
        end
        if coroutine.status(co) ~= "dead" then
            coroutine.close(co)
        end
        if success and result and type(result.CreateWindow) == "function" then
            return result
        end
    end
    return nil
end

-- ============================================================
-- แจ้งเตือนผู้ใช้เมื่อไม่มี Rayfield
-- ============================================================
local function showNotification(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 5,
        })
    end)
    print("[" .. title .. "] " .. text)
end

-- ============================================================
-- เริ่มการดั๊มป์ (เรียกจาก UI หรือ _G.StartDump())
-- ============================================================
local function startDumpInteractive(services)
    local gameName = pc(function() return game.Name end) or "UnknownGame"
    showNotification("Game Dumper", "กำลังสแกน...", 3)

    local results = Dump.run(services, function(prog)
        if prog.scanned % 500 == 0 then
            print(("  [%d inst / %d scripts] %s"):format(prog.scanned, prog.scripts, prog.current))
        end
    end)

    local save = saveDump(results, gameName)
    showNotification("เสร็จสิ้น", ("สแกน %d instance / %d สคริปต์\nบันทึกที่ %s"):format(results.scanned, results.scripts, save.base), 8)
    print("บันทึกที่: " .. save.base)
end

